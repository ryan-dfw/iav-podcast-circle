rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules --project <dev|prod>
//
// published/**  — what the site builds from. Anyone may read it (the build
//                 fetches it without credentials); only editors may write.
// everything else (drafts, revisions) — editors only.
//
// Editors are listed here and in CMS_ADMIN_EMAILS (Netlify env, used by
// netlify/functions/cms-rebuild.ts). Change both together.
service cloud.firestore {
  match /databases/{database}/documents {
    function isEditor() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'mckevitt.r@gmail.com',
          'iavpodcastcircle@gmail.com',
          'ishaface102@gmail.com'
        ];
    }

    match /published/{path=**} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /{path=**} {
      allow read, write: if isEditor();
    }
  }
}
