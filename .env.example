# Copy to .env.local and fill in once the client provides real values.
# Leave blank to keep the feature in its "not connected" state.
#
# The Circle Starter kit (netlify/functions/kit-*.ts) needs the three below.
# Set them in the Netlify UI for the deployed site; .env.local only covers
# local `netlify dev`.

# Signing key for kit access tokens. Any long random string:
#   openssl rand -hex 32
# Changing it invalidates every link already emailed — that's the kill switch.
CIRCLE_KIT_SECRET=

# https://resend.com — free tier, no card. API key from the dashboard.
RESEND_API_KEY=

# Who the journal link appears to come from. Required — there is no default,
# because the old fallback (onboarding@resend.dev) only delivers to the Resend
# account owner and silently 403s for everyone else.
# Must be an address on a domain verified in that Resend account.
# The domain needs no mailbox: replies are redirected by Reply-To to
# KIT_NOTIFY_EMAIL, so nothing is lost by hello@ not existing.
KIT_FROM_EMAIL="IAV Circle <hello@iavcircle.com>"

# Where the "someone verified their email" notice goes, and the Reply-To on
# mail sent to readers. Replies to a signup notice go back to that signup.
KIT_NOTIFY_EMAIL=

# Only needed if the public URL isn't what Netlify reports (it sets URL itself).
# SITE_URL=https://iavcircle.com

# --- Studio (/studio) -------------------------------------------------------
# Firebase web app config (Project settings → Your apps → Web). Not secret.
# Use the dev project locally and for branch deploys, the prod project for the
# production context. Leave VITE_FIREBASE_PROJECT_ID unset to build from the
# bundled content only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Netlify build hook for THIS context's branch (Site configuration → Build &
# deploy → Build hooks). Only netlify/functions/cms-rebuild.ts sees it.
CMS_BUILD_HOOK_URL=

# Accounts allowed to trigger rebuilds. Keep in sync with firestore.rules.
CMS_ADMIN_EMAILS=
